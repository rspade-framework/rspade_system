<Define:_Apidocs_Params_Table tag="div">
<% const params = this.args.params || []; %>
<% const pattern = this.args.pattern || ''; %>
<table class="_Apidocs_Params_Table__table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>In</th>
            <th>Required</th>
            <th>Default</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <% for (const p of params) { %>
            <% const in_path = pattern.indexOf(':' + p.name) !== -1; %>
            <% const loc = in_path ? 'path' : (p.type === 'file' ? 'multipart' : 'query / body'); %>
            <tr>
                <td class="_Apidocs_Params_Table__name">
                    <code><%= p.name %></code>
                    <% if (p.example !== null && p.example !== undefined) { %>
                        <span class="_Apidocs_Params_Table__example">e.g. <%= str(p.example) %></span>
                    <% } %>
                </td>
                <td><span class="_Apidocs_Params_Table__type"><%= p.type %></span></td>
                <td class="_Apidocs_Params_Table__loc"><%= loc %></td>
                <td>
                    <% if (p.required) { %>
                        <span class="_Apidocs_Params_Table__req">required</span>
                    <% } else { %>
                        <span class="_Apidocs_Params_Table__opt">optional</span>
                    <% } %>
                </td>
                <td class="_Apidocs_Params_Table__default">
                    <% if (p.default !== null && p.default !== undefined) { %><%= str(p.default) %><% } else { %>&mdash;<% } %>
                </td>
                <td class="_Apidocs_Params_Table__desc"><%= p.description || '' %></td>
            </tr>
        <% } %>
    </tbody>
</table>
</Define:_Apidocs_Params_Table>
