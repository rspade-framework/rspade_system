<%--
_Sys_Email_Action - the Email & SMS screen shell: two tabs, one per outbound queue,
each a headline region over its grid.

    email - _Sys_Email_Summary (a tile per status, the delivery mode, transport and
            the oldest pending row) over _Sys_Email_DataGrid (every queued email on
            the install; row -> _Sys_Email_View_Action)
    sms   - _Sys_Sms_Summary (a tile per status, the delivery mode, the oldest
            pending row) over _Sys_Sms_DataGrid (every queued SMS; row ->
            _Sys_Sms_View_Action)

The active tab is the hash key "tab" (email is the default); the grids' state is under
"mail_*" and "sms_*". A status tile narrows the grid beside it.
--%>
<Define:_Sys_Email_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
        <_Sys_Tabs $sid="tabs" $hash="tab" $tabs=([
            {key: 'email', label: 'Email', icon: 'bi-envelope'},
            {key: 'sms', label: 'SMS', icon: 'bi-phone'},
        ])>
            <Slot:email>
                <_Sys_Email_Summary $sid="email_summary" />
                <_Sys_Email_DataGrid $sid="mail_grid" />
            </Slot:email>
            <Slot:sms>
                <_Sys_Sms_Summary $sid="sms_summary" />
                <_Sys_Sms_DataGrid $sid="sms_grid" />
            </Slot:sms>
        </_Sys_Tabs>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Email_Action>
