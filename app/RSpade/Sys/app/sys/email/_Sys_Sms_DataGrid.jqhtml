<%--
_Sys_Sms_DataGrid - the SMS tab's queue: every _sms_queue row on the install, newest
first, every site's.

Server half: _Sys_Sms_DataGrid.php (filters status / category / site, search on the
number - envelope and original - or the body). Status and category filter by their
lowercase WORD, the mail grid's vocabulary. State lives in the URL hash under the grid
key "sms", so a link addresses a filtered grid as
Rsx.Route('_Sys_Email_Action', {}, {tab: 'sms', sms_f_status: 'failed'}).

Every row links to its detail screen (_Sys_Sms_View_Action).
--%>
<Define:_Sys_Sms_DataGrid extends="_Sys_DataGrid_Abstract"
    $grid_key="sms"
    $data_source=_Sys_Sms_Controller.datagrid_fetch
    $sort="id"
    $order="desc"
    $per_page=25
    $search="Search number or message..."
    $filters=([
        {key: 'status', label: 'All statuses', options: _Sys_Sms_Controller.status_options},
        {key: 'category', label: 'All categories', options: _Sys_Sms_Controller.category_options},
        {key: 'site', label: 'All sites', options: _Sys_Sms_Controller.site_options},
    ])>
    <Slot:header>
        <tr>
            <th data-sortby="id">ID</th>
            <th>Recipient</th>
            <th>Message</th>
            <th>Status</th>
            <th>Category</th>
            <th>Site</th>
            <th data-sortby="attempt_count">Attempts</th>
            <th data-sortby="created_at">Queued</th>
            <th data-sortby="sent_at">Sent</th>
        </tr>
    </Slot:header>
    <Slot:row>
        <tr data-href="<%= Rsx.Route('_Sys_Sms_View_Action', row.id) %>">
            <td class="_Sys_Sms_DataGrid__id"><%= row.id %></td>
            <td class="_Sys_Sms_DataGrid__recipient">
                <%= row.to_number %>
                <% if (row.dev_original_to) { %>
                    <div class="_Sys_Sms_DataGrid__original">for <%= row.dev_original_to %></div>
                <% } %>
            </td>
            <td class="_Sys_Sms_DataGrid__body" title="<%= row.error_excerpt || '' %>"><%= row.body %></td>
            <td><_Sys_Status_Badge $status=row.status /></td>
            <td><%= row.category_id__label %></td>
            <td class="_Sys_Sms_DataGrid__site">#<%= row.site_id %><% if (row.site_name) { %> <%= row.site_name %><% } %></td>
            <td><%= row.attempt_count %></td>
            <td><%= Rsx_Time.format_datetime(row.created_at) %></td>
            <td><%= row.sent_at ? Rsx_Time.format_datetime(row.sent_at) : '' %></td>
        </tr>
    </Slot:row>
    <Slot:empty>
        <_Sys_Empty_State $icon="bi-phone" $title="The SMS queue is empty" $body="No SMS has been queued on this install." />
    </Slot:empty>
</Define:_Sys_Sms_DataGrid>
