<%--
_Sys_Sms_View_Action - one _sms_queue row, any site's: its recipient and delivery
facts, the last error (the reason nothing was delivered, on a Suppressed row), the
message body and the transport response. Read-only - the SMS queue has no resend.

Three states: loading, a load failure (_Sys_Not_Found for a missing id, _Sys_Error
for anything else), and the record.
--%>
<Define:_Sys_Sms_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_Sms_View_Action__loading" />
    <% } else if (this.data.load_error && this.data.load_error.code === Ajax.ERROR_NOT_FOUND) { %>
        <_Sys_Not_Found $record_type="SMS" $back_label="Back to SMS" $back_url=(Rsx.Route('_Sys_Email_Action', {}, {tab: 'sms'})) />
    <% } else if (this.data.load_error) { %>
        <_Sys_Error $error_data=this.data.load_error.message />
    <% } else { %>
        <%
            const _m = this.data.sms;
            const _when = (iso) => iso ? Rsx_Time.format_datetime(iso) : null;
            const _is_suppressed = _m.status === 'suppressed';
            const _site = '#' + _m.site_id + (_m.site_name ? ' ' + _m.site_name : '');
        %>
        <_Sys_Page_Header $title=('SMS to ' + _m.to_number) $icon="bi-phone" $subtitle=('#' + _m.id + ', site ' + _site)>
            <Slot:meta>
                <_Sys_Status_Badge $status=_m.status />
                <span class="_Sys_Sms_View_Action__chip"><%= _m.category_id__label %></span>
            </Slot:meta>
            <Slot:actions>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_Email_Action', {}, {tab: 'sms'}) %>">All SMS</a>
            </Slot:actions>
        </_Sys_Page_Header>

        <% if (_m.last_error) { %>
            <%-- On a Suppressed row last_error is the REASON nothing was delivered, and
                 nothing went wrong - so it is not drawn as an error. --%>
            <_Sys_Section $title=(_is_suppressed ? 'Not delivered' : 'Last error') $icon=(_is_suppressed ? 'bi-info-circle' : 'bi-exclamation-octagon')>
                <_Sys_Code_Pane $text=_m.last_error />
            </_Sys_Section>
        <% } %>

        <_Sys_Section $title="Message" $icon="bi-chat-text">
            <_Sys_Code_Pane $text=_m.body />
        </_Sys_Section>

        <_Sys_Section $title="Details" $icon="bi-info-circle">
            <_Sys_Detail_List>
                <_Sys_Detail_Item $label="Status"><_Sys_Status_Badge $status=_m.status /></_Sys_Detail_Item>
                <_Sys_Detail_Item $label="To" $value=_m.to_number $mono=true />
                <_Sys_Detail_Item $label="Originally to" $value=_m.dev_original_to $mono=true />
                <_Sys_Detail_Item $label="Category" $value=_m.category_id__label />
                <_Sys_Detail_Item $label="Site" $value=_site />
                <_Sys_Detail_Item $label="Attempts" $value=_m.attempt_count />
                <_Sys_Detail_Item $label="Dedupe key" $value=_m.dedupe_key $mono=true />
                <_Sys_Detail_Item $label="Related" $value=(_m.related_id ? _m.related_type + ':' + _m.related_id : null) $mono=true />
                <_Sys_Detail_Item $label="Transport" $value=_m.transport $mono=true />
                <_Sys_Detail_Item $label="Queued" $value=_when(_m.created_at) />
                <_Sys_Detail_Item $label="Next attempt" $value=_when(_m.next_attempt_at) />
                <_Sys_Detail_Item $label="Last attempt" $value=_when(_m.last_attempt_at) />
                <_Sys_Detail_Item $label="Sent" $value=_when(_m.sent_at) />
                <_Sys_Detail_Item $label="Updated" $value=_when(_m.updated_at) />
            </_Sys_Detail_List>
        </_Sys_Section>

        <% if (_m.transport_response) { %>
            <_Sys_Section $title="Transport response" $icon="bi-reply">
                <_Sys_Code_Pane $text=_m.transport_response />
            </_Sys_Section>
        <% } %>
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Sms_View_Action>
