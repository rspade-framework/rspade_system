<%--
_Sys_Email_Summary - the Email screen's headline, install-wide: one tile per queue
status, then how this install delivers - the delivery mode (rsx.mail.delivery), the
transport it hands mail to, and the row that has waited longest.

Self-loading (_Sys_Email_Controller.summary); Refresh reloads it. The tiles are
_Sys_Queue_Status_Tiles (tab "email", grid key "mail"): a plain click narrows the
queue grid in place (_Sys_Email_Action), a modified click opens the filtered grid.
--%>
<Define:_Sys_Email_Summary>
<% if (this.data.loading) { %>
    <Spinner class="_Sys_Email_Summary__loading" />
<% } else if (this.data.error_data) { %>
    <_Sys_Section $title="Queue" $icon="bi-envelope">
        <_Sys_Error $error_data=this.data.error_data />
    </_Sys_Section>
<% } else { %>
    <%
        const _s = this.data.summary;
        const _oldest = _s.oldest_pending;
    %>
    <_Sys_Queue_Status_Tiles $counts=_s.counts $tab="email" $grid_key="mail" />

    <_Sys_Section $title="Delivery" $icon="bi-send">
        <Slot:actions>
            <button type="button" class="btn btn-sm btn-secondary" data-action="refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </Slot:actions>
        <Slot:body>
            <_Sys_Detail_List>
                <_Sys_Detail_Item $label="Delivery mode" $value=_s.delivery_mode $mono=true />
                <_Sys_Detail_Item $label="Transport" $value=_s.transport $mono=true />
                <_Sys_Detail_Item $label="Recorded as" $value=_s.transport_label $mono=true />
                <% if (_s.catcher_maildir) { %>
                    <_Sys_Detail_Item $label="Catcher Maildir" $value=_s.catcher_maildir $mono=true />
                <% } %>
                <% if (_oldest) { %>
                    <_Sys_Detail_Item $label="Oldest pending">
                        <a href="<%= Rsx.Route('_Sys_Email_View_Action', _oldest.id) %>">#<%= _oldest.id %></a>
                        to <%= _oldest.to_address %>, queued <%= Rsx_Time.relative(_oldest.created_at) %>
                    </_Sys_Detail_Item>
                <% } else { %>
                    <_Sys_Detail_Item $label="Oldest pending" $value="Nothing is waiting" />
                <% } %>
                <_Sys_Detail_Item $label="Total rows" $value=_s.total />
            </_Sys_Detail_List>
        </Slot:body>
    </_Sys_Section>
<% } %>
</Define:_Sys_Email_Summary>
