<%--
_Sys_Performance_Action - the Performance screen; see _Sys_Performance_Action.js.

Four sections: php-fpm now (each pool's live status), the last 100 per kind plus the
budget, the two charts of the last hour with the kind toggles, the last 10 per kind.
--%>
<Define:_Sys_Performance_Action>
<_Sys_Page_Scaffold class="_Sys_Page_Scaffold--wide">
    <Slot:main>
        <% if (this.data.loading) { %>
            <Spinner class="_Sys_Performance_Action__loading" />
        <% } else if (this.data.error_data) { %>
            <_Sys_Section $title="Performance" $icon="bi-speedometer2">
                <_Sys_Error $error_data=this.data.error_data />
            </_Sys_Section>
        <% } else { %>
            <%
                const _s = this.data.snapshot;
                const _b = _s.budget;
                const _pools = this.data.fpm ? this.data.fpm.pools : {web: null, ajax: null};
                const _kinds = _Sys_Performance_Action.KINDS;
                const _charts = this.chart_inputs();
            %>

            <% if (!_s.enabled) { %>
                <div class="alert alert-warning">Recording is off (rsx.metrics.enabled): nothing new is measured, and what is shown is what was recorded before.</div>
            <% } %>

            <_Sys_Section $title="php-fpm now" $icon="bi-hdd-network">
                <_Sys_Stat_Grid>
                    <% for (const _pool of ['web', 'ajax']) { %>
                        <% const _p = _pools[_pool]; %>
                        <% const _name = _pool === 'web' ? 'Web pool' : 'Ajax pool'; %>
                        <% if (_p) { %>
                            <_Sys_Stat_Tile $label=(_name + ' active') $icon="bi-activity" $value=(_p.active + ' of ' + _p.total)
                                $sub=(_p.idle + ' idle, ' + _p.queue + ' queued (most ' + _p.max_queue + '), max children reached ' + _p.max_children_reached + 'x')
                                $tone=(_p.queue > 0 || _p.max_children_reached > 0 ? 'warn' : 'ok') />
                        <% } else { %>
                            <_Sys_Stat_Tile $label=_name $icon="bi-activity" $value="no answer"
                                $sub="every worker may be busy, or this box serves no status page (the RSpade container does)" $tone="muted" />
                        <% } %>
                    <% } %>
                </_Sys_Stat_Grid>
            </_Sys_Section>

            <_Sys_Section $title="Last 100, per kind" $icon="bi-bar-chart">
                <_Sys_Stat_Grid>
                    <% for (const _k of _kinds) { %>
                        <% const _sum = _s.kinds[_k.key].summary; %>
                        <_Sys_Stat_Tile $label=(_k.label + ' peak memory') $icon="bi-memory"
                            $value=(_sum.count ? _sum.avg_peak_mb + ' MB' : '')
                            $sub=(_sum.count ? 'max ' + _sum.max_peak_mb + ' MB, ' + _sum.avg_ms + ' ms on average, ' + _sum.count + ' recorded' : 'nothing recorded yet') />
                    <% } %>
                </_Sys_Stat_Grid>
                <% if (_b) { %>
                    <_Sys_Stat_Grid class="_Sys_Performance_Action__budget">
                        <_Sys_Stat_Tile $label="Memory limit" $icon="bi-speedometer" $value=(_b.memory_limit_mb + ' MB') $sub="per PHP process, php-fpm and the CLI" />
                        <_Sys_Stat_Tile $label="Typical size" $icon="bi-rulers" $value=(_b.typical_mb + ' MB') $sub="what one process is sized at" />
                        <_Sys_Stat_Tile $label="php-fpm workers" $icon="bi-cpu" $value=_b.php_fpm_total
                            $sub=('web ' + _b.web + ', ajax ' + _b.ajax + (_b.pools_sized ? '' : ' (development pools unchanged)') + ', limited by ' + _b.ceiling) />
                        <_Sys_Stat_Tile $label="Task workers" $icon="bi-list-check" $value=_b.tasks $sub=(_b.scheduled + ' scheduled + ' + _b.on_demand + ' on demand') />
                        <_Sys_Stat_Tile $label="RAM for PHP" $icon="bi-hdd" $value=(_b.php_ram_mb + ' MB') $sub=(_b.php_ram_and_swap_mb + ' MB with swap') />
                    </_Sys_Stat_Grid>
                <% } else { %>
                    <p class="_Sys_Performance_Action__note">This box was not sized by the RSpade container, so there is no budget to compare against.</p>
                <% } %>
            </_Sys_Section>

            <_Sys_Section $title="The last hour" $icon="bi-graph-up">
                <Slot:actions>
                    <div class="_Sys_Performance_Action__toggles">
                        <% for (const _k of _kinds) { %>
                            <label class="form-check form-switch mb-0">
                                <input type="checkbox" class="form-check-input" data-kind-toggle="<%= _k.key %>" <% if (this.state.visible.includes(_k.key)) { %>checked<% } %> />
                                <span class="form-check-label"><%= _k.label %></span>
                            </label>
                        <% } %>
                    </div>
                </Slot:actions>
                <Slot:body>
                    <div class="row g-3">
                        <div class="col-xl-6">
                            <div class="_Sys_Performance_Action__chart-title">Memory held (average per minute)</div>
                            <_Sys_Stacked_Chart $sid="memory_chart" $unit="MB" $series=_charts.memory.series $ceilings=_charts.memory.ceilings $visible=this.state.visible />
                        </div>
                        <div class="col-xl-6">
                            <div class="_Sys_Performance_Action__chart-title">Processes at work (average per minute)</div>
                            <_Sys_Stacked_Chart $sid="workers_chart" $unit="" $series=_charts.workers.series $ceilings=_charts.workers.ceilings $visible=this.state.visible />
                        </div>
                    </div>
                </Slot:body>
            </_Sys_Section>

            <_Sys_Section $title="Last 10, per kind" $icon="bi-clock-history" $flush=true>
                <_Sys_Tabs $hash="recent" $tabs=(_kinds.map((k) => ({key: k.key, label: k.label, count: _s.kinds[k.key].summary.count})))>
                    <Slot:page><_Sys_Performance_Recent $rows=_s.kinds.page.recent /></Slot:page>
                    <Slot:ajax><_Sys_Performance_Recent $rows=_s.kinds.ajax.recent /></Slot:ajax>
                    <Slot:api><_Sys_Performance_Recent $rows=_s.kinds.api.recent /></Slot:api>
                    <Slot:task><_Sys_Performance_Recent $rows=_s.kinds.task.recent /></Slot:task>
                </_Sys_Tabs>
            </_Sys_Section>
        <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Performance_Action>
