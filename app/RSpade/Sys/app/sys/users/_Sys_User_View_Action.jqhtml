<%--
_Sys_User_View_Action - one login identity (login_users.id): its facts and every site
membership, its live sessions, its sign-in history and its second factors and
connected sign-in providers, and the actions on them.

Three states: loading, a load failure (_Sys_Not_Found for a missing or soft-deleted
identity; _Sys_Error for anything else), and the record - a header over four tabs
(hash key "tab"):

    overview - the identity's facts + _Sys_User_Memberships (every site)
    sessions - _Sys_User_Sessions (self-loading)
    signins  - _Sys_User_Signins_DataGrid (grid key "signins", every row, paged)
    security - _Sys_User_Security (self-loading)

Actions: identity-wide ones in the header (Sign in as this user, Change status, End
all sessions); a
membership's Enable/Disable on its row (handled here, since the memberships are this
action's data); ending one session, removing factors and disconnecting providers in
their own tab's region. Each confirms with _Sys_Modal first; a row the server marks
with a refusal explains it instead of confirming.
--%>
<Define:_Sys_User_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_User_View_Action__loading" />
    <% } else if (this.data.load_error && this.data.load_error.code === Ajax.ERROR_NOT_FOUND) { %>
        <_Sys_Not_Found $record_type="User" $back_label="Back to users" $back_url=(Rsx.Route('_Sys_Users_Action')) />
    <% } else if (this.data.load_error) { %>
        <_Sys_Error $error_data=this.data.load_error.message />
    <% } else { %>
        <%
            const _u = this.data.user;
            const _n = _u.membership_count;
        %>
        <_Sys_Page_Header $title=_u.email $icon="bi-person-badge" $subtitle=('Login identity #' + _u.id + ' - ' + (_n === 1 ? '1 membership' : _n + ' memberships'))>
            <Slot:meta>
                <_Sys_Status_Badge $status=_u.status $label=_u.status_label />
                <% if (_u.is_developer) { %>
                    <_Sys_Status_Badge $status="info" $label="Developer" />
                <% } %>
                <% if (_u.is_self) { %>
                    <span class="_Sys_User_View_Action__note">you</span>
                <% } %>
            </Slot:meta>
            <Slot:actions>
                <button type="button" class="btn btn-sm btn-primary" data-action="sign-in-as"><i class="bi bi-person-fill-up"></i> Sign in as this user</button>
                <button type="button" class="btn btn-sm btn-primary" data-action="status"><i class="bi bi-person-gear"></i> Change status</button>
                <button type="button" class="btn btn-sm btn-danger" data-action="terminate-all"><i class="bi bi-box-arrow-right"></i> End all sessions</button>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_Users_Action') %>">All users</a>
            </Slot:actions>
        </_Sys_Page_Header>

        <_Sys_Tabs $sid="tabs" $hash="tab" $tabs=([
            {key: 'overview', label: 'Overview', icon: 'bi-info-circle'},
            {key: 'sessions', label: 'Sessions', icon: 'bi-laptop'},
            {key: 'signins', label: 'Sign-ins', icon: 'bi-box-arrow-in-right'},
            {key: 'security', label: 'Security', icon: 'bi-shield-lock'},
        ])>
            <Slot:overview>
                <div class="_Sys_User_View_Action__stack">
                    <_Sys_Section $title="Details" $icon="bi-info-circle">
                        <_Sys_Detail_List>
                            <_Sys_Detail_Item $label="ID" $value=_u.id $mono=true />
                            <_Sys_Detail_Item $label="Email" $value=_u.email />
                            <_Sys_Detail_Item $label="Status">
                                <_Sys_Status_Badge $status=_u.status $label=_u.status_label />
                            </_Sys_Detail_Item>
                            <_Sys_Detail_Item $label="Developer" $value=(_u.is_developer ? 'Yes - may open this panel' : 'No') />
                            <_Sys_Detail_Item $label="Verified" $value=(_u.is_verified ? 'Yes' : 'No') />
                            <_Sys_Detail_Item $label="Activated" $value=(_u.is_activated ? 'Yes' : 'No') />
                            <_Sys_Detail_Item $label="Last sign-in" $value=(_u.last_login ? Rsx_Time.format_datetime(_u.last_login) : 'Never') />
                            <_Sys_Detail_Item $label="Timezone" $value=(_u.timezone ? _u.timezone + (_u.timezone_auto ? ' (from the browser)' : '') : null) />
                            <_Sys_Detail_Item $label="Created" $value=(_u.created_at ? Rsx_Time.format_datetime(_u.created_at) : null) />
                            <_Sys_Detail_Item $label="Updated" $value=(_u.updated_at ? Rsx_Time.format_datetime(_u.updated_at) : null) />
                        </_Sys_Detail_List>
                    </_Sys_Section>
                    <_Sys_User_Memberships $memberships=this.data.memberships />
                </div>
            </Slot:overview>
            <Slot:sessions><_Sys_User_Sessions $sid="sessions" $login_user_id=_u.id $email=_u.email /></Slot:sessions>
            <Slot:signins><_Sys_User_Signins_DataGrid $sid="signins" $base_params=({login_user_id: _u.id}) /></Slot:signins>
            <Slot:security><_Sys_User_Security $sid="security" $login_user_id=_u.id $email=_u.email /></Slot:security>
        </_Sys_Tabs>
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_User_View_Action>
