<%--
_Sys_User_Session_View_Action - one user session of a login identity: one browser's sign-in
as it on one site (as one impersonator, or none), however many times it signed in there.
Its facts, and every address and browser it acted from.

Three states: loading, a load failure (_Sys_Not_Found when the identity is missing or the id
is not one of the identity's listed sessions - the screen shows exactly what the Sessions tab
lists; _Sys_Error for anything else), and the record - a header (device, signed in / out,
End session while signed in and not an API key's use, Back to the identity) over the facts
and _Sys_Audit_Sessions_DataGrid.
--%>
<Define:_Sys_User_Session_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_User_Session_View_Action__loading" />
    <% } else if (this.data.load_error && this.data.load_error.code === Ajax.ERROR_NOT_FOUND) { %>
        <_Sys_Not_Found $record_type="Session" $back_label="Back to the user" $back_url=(Rsx.Route('_Sys_User_View_Action', this.args.id, {tab: 'sessions'})) />
    <% } else if (this.data.load_error) { %>
        <_Sys_Error $error_data=this.data.load_error.message />
    <% } else { %>
        <%
            const _u = this.data.user;
            const _s = this.data.session;
        %>
        <_Sys_Page_Header $title=_s.device_summary $icon="bi-laptop" $subtitle=(_u.email + ' - session #' + _s.id)>
            <Slot:meta>
                <% if (_s.is_signed_in) { %>
                    <_Sys_Status_Badge $status="ok" $label="Signed in" />
                <% } else { %>
                    <_Sys_Status_Badge $status="muted" $label="Signed out" />
                <% } %>
                <% if (_s.is_api) { %>
                    <_Sys_Status_Badge $status="info" $label="API key" />
                <% } %>
                <% if (_s.impersonator_login_user_id) { %>
                    <_Sys_Status_Badge $status="warn" $label="Impersonation" />
                <% } %>
                <% if (_s.is_current) { %>
                    <span class="_Sys_User_Session_View_Action__note">this browser</span>
                <% } %>
            </Slot:meta>
            <Slot:actions>
                <% if (_s.is_signed_in && !_s.is_api) { %>
                    <button type="button" class="btn btn-sm btn-danger" data-action="terminate"><i class="bi bi-box-arrow-right"></i> End session</button>
                <% } %>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_User_View_Action', _u.id, {tab: 'sessions'}) %>">All sessions</a>
            </Slot:actions>
        </_Sys_Page_Header>

        <_Sys_Section $title="Details" $icon="bi-info-circle">
            <_Sys_Detail_List>
                <_Sys_Detail_Item $label="Identity">
                    <a href="<%= Rsx.Route('_Sys_User_View_Action', _u.id) %>"><%= _u.email %></a>
                </_Sys_Detail_Item>
                <_Sys_Detail_Item $label="State" $value=(_s.is_signed_in ? 'Signed in' : (_s.sign_out_reason || 'Signed out') + ' - ' + Rsx_Time.format_timestamp(_s.signed_out_at)) />
                <_Sys_Detail_Item $label="Site">
                    <% if (_s.site_id !== null) { %>
                        <span class="_Sys_User_Session_View_Action__mono">#<%= _s.site_id %></span> <%= _s.site_name || '' %>
                    <% } %>
                </_Sys_Detail_Item>
                <_Sys_Detail_Item $label="Browser type" $value=_s.type_label />
                <_Sys_Detail_Item $label="Last IP" $value=_s.ip_address $mono=true />
                <_Sys_Detail_Item $label="User agent" $value=_s.user_agent />
                <_Sys_Detail_Item $label="First signed in here" $value=(_s.first_seen ? Rsx_Time.format_timestamp(_s.first_seen) : null) />
                <_Sys_Detail_Item $label="This sign-in" $value=(_s.signed_in_at ? Rsx_Time.format_timestamp(_s.signed_in_at) : null) />
                <_Sys_Detail_Item $label="Last active" $value=(_s.last_active ? Rsx_Time.format_timestamp(_s.last_active) + ' (' + Rsx_Time.relative(_s.last_active) + ')' : null) />
                <_Sys_Detail_Item $label="Sign-ins" $value=_s.sign_in_count />
                <% if (_s.impersonator_login_user_id) { %>
                    <_Sys_Detail_Item $label="Impersonated by">
                        <a href="<%= Rsx.Route('_Sys_User_View_Action', _s.impersonator_login_user_id) %>"><%= _s.impersonator_email || ('#' + _s.impersonator_login_user_id) %></a>
                        <% if (_s.impersonation_started_at) { %>
                            <span class="_Sys_User_Session_View_Action__dim">since <%= Rsx_Time.format_timestamp(_s.impersonation_started_at) %></span>
                        <% } %>
                    </_Sys_Detail_Item>
                <% } %>
            </_Sys_Detail_List>
        </_Sys_Section>

        <_Sys_Audit_Sessions_DataGrid $data_source=_Sys_Users_Controller.audit_sessions_fetch $base_params=({login_user_id: _u.id, user_session_id: _s.id}) />
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_User_Session_View_Action>
