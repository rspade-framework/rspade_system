<%--
_Sys_Site_Members_DataGrid - one site's members on its detail screen: each live
membership beside the login identity it belongs to.

$base_params=({site_id: <id>}) - the site (required); sent with every request

Server half: _Sys_Site_Members_DataGrid.php (filter enabled = the membership's own
switch, search on email or name). Grid key "members". "Active" is User_Model's
definition - the membership enabled AND the site enabled - so every member of a
disabled site reads Inactive.

A member's email links to its identity on the Users screen (_Sys_User_View_Action); an invitation not
yet accepted has no login identity and no link.
--%>
<Define:_Sys_Site_Members_DataGrid extends="_Sys_DataGrid_Abstract"
    $grid_key="members"
    $data_source=_Sys_Sites_Controller.members_fetch
    $title="Members"
    $sort="role_id"
    $order="asc"
    $per_page=25
    $search="Search email or name..."
    $filters=([
        {key: 'enabled', label: 'Enabled and disabled', options: [
            {value: 'enabled', label: 'Membership enabled'},
            {value: 'disabled', label: 'Membership disabled'},
        ]},
    ])>
    <Slot:header>
        <tr>
            <th data-sortby="email">Email</th>
            <th>Name</th>
            <th data-sortby="role_id">Role</th>
            <th>Membership</th>
            <th>Active</th>
            <th data-sortby="last_login">Last sign-in</th>
        </tr>
    </Slot:header>
    <Slot:row>
        <tr>
            <td>
                <% if (row.login_user_id) { %>
                    <a href="<%= Rsx.Route('_Sys_User_View_Action', row.login_user_id) %>"><%= row.email %></a>
                <% } else { %>
                    <%= row.email %> <span class="_Sys_Site_Members_DataGrid__note">invited</span>
                <% } %>
            </td>
            <td><%= [row.first_name, row.last_name].filter(Boolean).join(' ') %></td>
            <td><%= row.role_label %></td>
            <td><_Sys_Status_Badge $status=(row.is_enabled ? 'ok' : 'muted') $label=(row.is_enabled ? 'Enabled' : 'Disabled') /></td>
            <td><_Sys_Status_Badge $status=(row.is_active ? 'ok' : 'warn') $label=(row.is_active ? 'Active' : 'Inactive') /></td>
            <td><%= row.last_login ? Rsx_Time.format_datetime(row.last_login) : 'Never' %></td>
        </tr>
    </Slot:row>
    <Slot:empty>
        <_Sys_Empty_State $icon="bi-people" $title="No members" $body="Nobody belongs to this site." />
    </Slot:empty>
</Define:_Sys_Site_Members_DataGrid>
