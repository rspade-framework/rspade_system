<%--
_Sys_Site_View_Action - one tenant site: its facts, Rename, Enable/Disable, and its
members (_Sys_Site_Members_DataGrid).

Three states: loading, a load failure (_Sys_Not_Found for site 0, a soft-deleted or
a missing id; _Sys_Error for anything else), and the record.
--%>
<Define:_Sys_Site_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_Site_View_Action__loading" />
    <% } else if (this.data.load_error && this.data.load_error.code === Ajax.ERROR_NOT_FOUND) { %>
        <_Sys_Not_Found $record_type="Site" $back_label="Back to sites" $back_url=(Rsx.Route('_Sys_Sites_Action')) />
    <% } else if (this.data.load_error) { %>
        <_Sys_Error $error_data=this.data.load_error.message />
    <% } else { %>
        <%
            const _s = this.data.site;
        %>
        <_Sys_Page_Header $title=_s.name $icon="bi-buildings" $subtitle=('Site #' + _s.id + ' - ' + _s.slug)>
            <Slot:meta>
                <_Sys_Status_Badge $status=(_s.is_enabled ? 'ok' : 'muted') $label=(_s.is_enabled ? 'Enabled' : 'Disabled') />
                <% if (_s.is_current_site) { %>
                    <span class="_Sys_Site_View_Action__note">your session's site</span>
                <% } %>
            </Slot:meta>
            <Slot:actions>
                <button type="button" class="btn btn-sm btn-primary" data-action="rename"><i class="bi bi-pencil"></i> Rename</button>
                <% if (_s.is_enabled && _s.can_disable) { %>
                    <button type="button" class="btn btn-sm btn-danger" data-action="disable"><i class="bi bi-slash-circle"></i> Disable</button>
                <% } else if (!_s.is_enabled) { %>
                    <button type="button" class="btn btn-sm btn-success" data-action="enable"><i class="bi bi-check-circle"></i> Enable</button>
                <% } %>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_Sites_Action') %>">All sites</a>
            </Slot:actions>
        </_Sys_Page_Header>

        <_Sys_Section $title="Details" $icon="bi-info-circle">
            <_Sys_Detail_List>
                <_Sys_Detail_Item $label="ID" $value=_s.id $mono=true />
                <_Sys_Detail_Item $label="Name" $value=_s.name />
                <_Sys_Detail_Item $label="Slug" $value=_s.slug $mono=true />
                <_Sys_Detail_Item $label="Status">
                    <_Sys_Status_Badge $status=(_s.is_enabled ? 'ok' : 'muted') $label=(_s.is_enabled ? 'Enabled' : 'Disabled') />
                    <% if (!_s.is_enabled) { %>
                        <span class="_Sys_Site_View_Action__hint">its members cannot sign in</span>
                    <% } %>
                </_Sys_Detail_Item>
                <_Sys_Detail_Item $label="Timezone" $value=_s.timezone />
                <_Sys_Detail_Item $label="Members" $value=(_s.member_count + ' (' + _s.enabled_member_count + ' with the membership enabled)') />
                <_Sys_Detail_Item $label="Created">
                    <%= _s.created_at ? Rsx_Time.format_datetime(_s.created_at) : '' %>
                    <% if (_s.created_by_author) { %>
                        <span class="_Sys_Site_View_Action__hint">by <Record_Author $author=_s.created_by_author /></span>
                    <% } %>
                </_Sys_Detail_Item>
                <_Sys_Detail_Item $label="Updated">
                    <%= _s.updated_at ? Rsx_Time.format_datetime(_s.updated_at) : '' %>
                    <% if (_s.updated_by_author) { %>
                        <span class="_Sys_Site_View_Action__hint">by <Record_Author $author=_s.updated_by_author /></span>
                    <% } %>
                </_Sys_Detail_Item>
            </_Sys_Detail_List>
        </_Sys_Section>

        <_Sys_Site_Members_DataGrid $base_params=({site_id: _s.id}) />
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Site_View_Action>
