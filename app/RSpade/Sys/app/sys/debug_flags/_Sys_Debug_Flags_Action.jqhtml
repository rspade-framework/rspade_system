<%--
_Sys_Debug_Flags_Action - the Debug Flags screen: this browser's console_debug
override, then the configuration in force with where each value came from.

Three states: loading, a load failure, the screen.
--%>
<Define:_Sys_Debug_Flags_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_Debug_Flags_Action__loading" />
    <% } else if (this.data.error_data) { %>
        <_Sys_Error $error_data=this.data.error_data />
    <% } else { %>
        <_Sys_Debug_Flags_Form $sid="form" $state=this.data.state $channels=this.data.channels />
        <_Sys_Debug_Flags_Reference $state=this.data.state />
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Debug_Flags_Action>
