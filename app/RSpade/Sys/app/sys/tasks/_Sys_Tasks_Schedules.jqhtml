<%--
_Sys_Tasks_Schedules - the Tasks screen's Schedules tab: every #[Schedule] declaration with
its registration (_task_schedules) and run statistics, with Run now per schedule.

Self-loading (_Sys_Tasks_Controller.schedules); Refresh reloads this region only. Each run of
a schedule is a run of its own (in the Tasks tab); "Last run" names the latest and opens it,
"Failures" counts the runs that failed since the last success. A schedule whose failures reach
rsx.tasks.failing_schedule_warn_after is toned fail.
--%>
<Define:_Sys_Tasks_Schedules>
<% if (this.data.loading) { %>
    <_Sys_Section $title="Schedules" $icon="bi-calendar-event">
        <Spinner class="_Sys_Tasks_Schedules__loading" />
    </_Sys_Section>
<% } else if (this.data.error_data) { %>
    <_Sys_Section $title="Schedules" $icon="bi-calendar-event">
        <_Sys_Error $error_data=this.data.error_data />
    </_Sys_Section>
<% } else { %>
    <%
        const _rows = this.data.rows;
    %>
    <_Sys_Section $title="Schedules" $icon="bi-calendar-event" $count=_rows.length $flush=true>
        <Slot:actions>
            <button type="button" class="btn btn-sm btn-secondary" data-action="refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </Slot:actions>
        <Slot:body>
            <% if (!_rows.length) { %>
                <_Sys_Empty_State $icon="bi-calendar-x" $title="No schedules" $body="No task method declares #[Schedule]." />
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Schedule</th>
                                <th>Next run</th>
                                <th>Last run</th>
                                <th>Last success</th>
                                <th>Failures</th>
                                <th>Last error</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const [_i, row] of _rows.entries()) { %>
                                <% const _r = row.registered; %>
                                <tr class="<%= row.failing ? '_Sys_Tasks_Schedules__row--fail' : '' %>">
                                    <td>
                                        <div class="_Sys_Tasks_Schedules__class"><%= row.class_short %>::</div>
                                        <span class="_Sys_Tasks_Schedules__mono"><%= row.method %></span>
                                        <% if (row.concurrency) { %>
                                            <span class="_Sys_Tasks_Schedules__tag"><%= row.concurrency %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div><%= row.schedule %></div>
                                        <% if (row.cron !== row.schedule) { %>
                                            <div class="_Sys_Tasks_Schedules__cron"><%= row.cron %></div>
                                        <% } %>
                                    </td>
                                    <% if (!_r) { %>
                                        <td colspan="5" class="_Sys_Tasks_Schedules__dim">not yet registered (rsx:task:process registers it on its next tick)</td>
                                    <% } else { %>
                                        <td><%= Rsx_Time.format_datetime(_r.next_run_at) %></td>
                                        <td>
                                            <% if (_r.last_task_id) { %>
                                                <a href="#" data-action="open_run" data-task-id="<%= _r.last_task_id %>">#<%= _r.last_task_id %></a>
                                                <% if (_r.last_run_status_id) { %>
                                                    <Task_Status_Badge $task=({status_id: _r.last_run_status_id, status: _r.last_run_status, status_reason: null}) />
                                                <% } %>
                                            <% } else { %>
                                                <span class="_Sys_Tasks_Schedules__dim">never</span>
                                            <% } %>
                                        </td>
                                        <td><%= _r.last_success_at ? Rsx_Time.format_datetime(_r.last_success_at) : 'never' %></td>
                                        <td class="<%= row.failing ? '_Sys_Tasks_Schedules__failures' : '' %>"><%= _r.consecutive_failures || '' %></td>
                                        <td>
                                            <% if (_r.consecutive_failures > 0 && _r.error_excerpt) { %>
                                                <span class="_Sys_Tasks_Schedules__error">
                                                    <span class="_Sys_Tasks_Schedules__error-at"><%= _r.last_error_at ? Rsx_Time.relative(_r.last_error_at) : '' %></span>
                                                    <%= _r.error_excerpt %>
                                                </span>
                                            <% } %>
                                        </td>
                                    <% } %>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-primary" data-action="run_now" data-index="<%= _i %>">
                                            <i class="bi bi-play-fill"></i> Run now
                                        </button>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </Slot:body>
    </_Sys_Section>
<% } %>
</Define:_Sys_Tasks_Schedules>
