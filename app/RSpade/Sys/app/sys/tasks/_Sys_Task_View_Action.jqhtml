<%--
_Sys_Task_View_Action - one run as a page: its facts and actions, its live output and its
reports (_Sys_Task_Detail). A run that does not exist shows the facts column's error.
--%>
<Define:_Sys_Task_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
        <_Sys_Page_Header $title=('Task #' + this.args.id) $icon="bi-gear-wide-connected">
            <Slot:actions>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_Tasks_Action', {}, {tab: 'tasks'}) %>">All tasks</a>
            </Slot:actions>
        </_Sys_Page_Header>
        <div class="_Sys_Task_View_Action__detail">
            <_Sys_Task_Detail $task_id=int(this.args.id) />
        </div>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Task_View_Action>
