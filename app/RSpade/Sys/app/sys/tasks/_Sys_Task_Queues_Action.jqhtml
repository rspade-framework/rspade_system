<%--
_Sys_Task_Queues_Action - every queue label that holds pending or running work, beside
the ONE worker pool that drains them all.

A queue is a LABEL on a _tasks row ($options['queue'], #[Task(queue: ...)]). Workers are
generic and are not assigned to a queue: the pool runs up to rsx.tasks.global_max_workers
of them, and a worker claims run-now work first (oldest first), then due schedules,
whatever the label. So the pool tiles answer "how many workers", and the table answers
"what is each label waiting on".

Per queue:
  Running        rows a worker has claimed; "stale" are those whose worker process is gone
                 on this host (the row is abandoned; rsx:task:process settles it next tick)
  Pending        one-shot rows due now, waiting for a worker
  Held           one-shot rows not due yet (a delayed dispatch, or a retry backoff)
  Schedules      #[Schedule] tracker rows, and how many are due now
  Oldest pending how long the longest-waiting due row has waited

Each count links to the Tasks history filtered to that queue and status.
--%>
<Define:_Sys_Task_Queues_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <_Sys_Page_Header $title="Task Queues" $icon="bi-stack" $subtitle="One worker pool drains every queue label">
        <Slot:actions>
            <button type="button" class="btn btn-sm btn-secondary" data-action="refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </Slot:actions>
    </_Sys_Page_Header>

    <% if (this.data.loading) { %>
        <Spinner class="_Sys_Task_Queues_Action__loading" />
    <% } else if (this.data.error_data) { %>
        <_Sys_Error $error_data=this.data.error_data />
    <% } else { %>
        <%
            const _pool = this.data.pool;
            const _queues = this.data.queues;
            const _sum = (key) => _queues.reduce((total, row) => total + row[key], 0);
            const _running = _sum('running');
            const _stale = _sum('stale_running');
            const _pending = _sum('pending_due');
            const _history = (queue, status) => Rsx.Route('_Sys_Tasks_Action', {}, {tab: 'history', tasks_f_queue: queue, tasks_f_status: status});
            const _running_url = Rsx.Route('_Sys_Tasks_Action', {}, {tab: 'running'});
        %>
        <_Sys_Stat_Grid>
            <_Sys_Stat_Tile $label="Worker cap" $icon="bi-sliders" $value=_pool.max_workers $sub="rsx.tasks.global_max_workers" />
            <_Sys_Stat_Tile $label="Live workers" $icon="bi-cpu" $value=_pool.members $sub="connected to rsx-lockd now" $tone=(_pool.members >= _pool.max_workers ? 'warn' : 'ok') />
            <_Sys_Stat_Tile $label="Running" $icon="bi-play-circle" $value=_running $sub=(_stale ? _stale + ' with no live worker' : 'rows claimed by a worker') $tone=(_stale ? 'fail' : null) $href=_running_url />
            <_Sys_Stat_Tile $label="Pending" $icon="bi-hourglass-split" $value=_pending $sub="due now, waiting for a worker" $tone=(_pending && !_pool.members ? 'warn' : null) />
        </_Sys_Stat_Grid>

        <_Sys_Section $title="Queues" $icon="bi-stack" $count=_queues.length $flush=true>
            <% if (!_queues.length) { %>
                <_Sys_Empty_State $icon="bi-moon" $title="Every queue is empty" $body="No task is pending or running." />
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Queue</th>
                                <th class="text-end">Running</th>
                                <th class="text-end">Pending</th>
                                <th class="text-end">Held</th>
                                <th class="text-end">Schedules</th>
                                <th>Oldest pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const row of _queues) { %>
                                <tr>
                                    <td class="_Sys_Task_Queues_Action__queue"><%= row.queue %></td>
                                    <td class="text-end">
                                        <a href="<%= _history(row.queue, 'running') %>"><%= row.running %></a>
                                        <% if (row.stale_running) { %>
                                            <span class="_Sys_Task_Queues_Action__stale"><%= row.stale_running %> stale</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end"><a href="<%= _history(row.queue, 'pending') %>"><%= row.pending_due %></a></td>
                                    <td class="text-end"><%= row.pending_later %></td>
                                    <td class="text-end"><%= row.schedules %><% if (row.schedules_due) { %> <span class="_Sys_Task_Queues_Action__due">(<%= row.schedules_due %> due)</span><% } %></td>
                                    <td><%= row.oldest_due_at ? Rsx_Time.relative(row.oldest_due_at) : '' %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </_Sys_Section>
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Task_Queues_Action>
