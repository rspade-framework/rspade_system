<%--
_Sys_Portal_User_Security - a portal user's Security tab: its second factors and its
connected sign-in providers, as metadata only - never a TOTP seed, a passkey key or a
recovery code (Rsx_Portal_Two_Factor::list_credentials() and Rsx_Portal_Sso::
identities_list() answer no such thing, and neither does this screen). Read-only.

$portal_user_id - the portal user (required)

Self-loading (_Sys_Portal_Users_Controller.security). Two sections: "Two-factor" (whether a
password or federated portal sign-in owes a challenge, each confirmed factor, the count of
unspent recovery codes) and "Sign-in providers" (each connected account).
--%>
<Define:_Sys_Portal_User_Security>
<% if (this.data.loading) { %>
    <_Sys_Section $title="Security" $icon="bi-shield-lock">
        <Spinner class="_Sys_Portal_User_Security__loading" />
    </_Sys_Section>
<% } else if (this.data.error_data) { %>
    <_Sys_Section $title="Security" $icon="bi-shield-lock">
        <_Sys_Error $error_data=this.data.error_data />
    </_Sys_Section>
<% } else { %>
    <%
        const _tf = this.data.two_factor;
        const _sso = this.data.sso;
    %>
    <div class="_Sys_Portal_User_Security__stack">
        <_Sys_Section $title="Two-factor" $icon="bi-shield-lock" $count=_tf.credentials.length $flush=true>
            <Slot:body>
            <div class="_Sys_Portal_User_Security__facts">
                <_Sys_Detail_List>
                    <_Sys_Detail_Item $label="Second factor">
                        <_Sys_Status_Badge $status=(_tf.is_enabled ? 'ok' : 'muted') $label=(_tf.is_enabled ? 'Enabled' : 'Not enrolled') />
                        <span class="_Sys_Portal_User_Security__dim"><%= _tf.is_enabled ? 'a password or provider sign-in is challenged' : 'a password alone signs in' %></span>
                    </_Sys_Detail_Item>
                    <_Sys_Detail_Item $label="Passkey" $value=(_tf.has_passkey ? 'Yes - may also sign in without a password' : 'No') />
                    <_Sys_Detail_Item $label="Recovery codes" $value=(_tf.recovery_codes_remaining + ' unspent' + (_tf.issues_recovery_codes ? '' : ' - this deployment issues none')) />
                </_Sys_Detail_List>
            </div>
            <% if (_tf.credentials.length) { %>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Factor</th>
                                <th>Label</th>
                                <th>Enrolled</th>
                                <th>Last used</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const row of _tf.credentials) { %>
                                <tr>
                                    <td><%= row.type_id__label %></td>
                                    <td><%= row.label || '' %></td>
                                    <td><%= row.confirmed_at ? Rsx_Time.format_datetime(row.confirmed_at) : '' %></td>
                                    <td><%= row.last_used_at ? Rsx_Time.format_datetime(row.last_used_at) : 'Never' %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
            </Slot:body>
        </_Sys_Section>

        <_Sys_Section $title="Sign-in providers" $icon="bi-key" $count=_sso.identities.length $flush=true>
            <Slot:body>
            <% if (!_sso.identities.length) { %>
                <_Sys_Empty_State $icon="bi-key" $title="No connected providers" $body=(_sso.is_enabled ? 'This portal user signs in with no external provider.' : 'No sign-in provider is enabled for the client portal on this install.') />
            <% } else { %>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Provider</th>
                                <th>Account email</th>
                                <th>Account name</th>
                                <th>Connected</th>
                                <th>Last sign-in</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const row of _sso.identities) { %>
                                <tr>
                                    <td><%= row.provider_label %></td>
                                    <td><%= row.email || '' %></td>
                                    <td><%= row.name || '' %></td>
                                    <td><%= row.created_at ? Rsx_Time.format_datetime(row.created_at) : '' %></td>
                                    <td><%= row.last_login_at ? Rsx_Time.format_datetime(row.last_login_at) : 'Never' %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
            </Slot:body>
        </_Sys_Section>
    </div>
<% } %>
</Define:_Sys_Portal_User_Security>
