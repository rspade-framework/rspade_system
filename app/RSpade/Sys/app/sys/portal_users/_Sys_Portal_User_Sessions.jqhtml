<%--
_Sys_Portal_User_Sessions - a portal user's Sessions tab: where it is signed in to the client
portal - one row per browser (x the staff member viewing as it), signed in and recently
signed out, most recently active first - from Portal_Session::get_sessions_for_user().
Read-only.

$portal_user_id - the portal user (required)

Self-loading (_Sys_Portal_Users_Controller.sessions); Refresh reloads this region only. A
signed-out row shows when and why. "View as Client" marks a staff member's own browser
viewing the portal as this user (Portal_Session::begin_impersonation_from_staff()), naming
the staff member; "this browser" marks the browser the page is read with, which appears
only while it carries this portal identity. Each row's Device links to the session screen
(_Sys_Portal_User_Session_View_Action), which lists the addresses and browsers it acted
from.
--%>
<Define:_Sys_Portal_User_Sessions>
<% if (this.data.loading) { %>
    <_Sys_Section $title="Sessions" $icon="bi-laptop">
        <Spinner class="_Sys_Portal_User_Sessions__loading" />
    </_Sys_Section>
<% } else if (this.data.error_data) { %>
    <_Sys_Section $title="Sessions" $icon="bi-laptop">
        <_Sys_Error $error_data=this.data.error_data />
    </_Sys_Section>
<% } else { %>
    <% const _rows = this.data.sessions; %>
    <_Sys_Section $title="Sessions" $icon="bi-laptop" $count=_rows.length $flush=true>
        <Slot:actions>
            <button type="button" class="btn btn-sm btn-secondary" data-action="refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </Slot:actions>
        <Slot:body>
            <% if (!_rows.length) { %>
                <_Sys_Empty_State $icon="bi-laptop" $title="No sessions" $body="This portal user is not signed in anywhere and has not signed out recently." />
            <% } else { %>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>State</th>
                                <th>Last IP</th>
                                <th>Signed in</th>
                                <th>Last active</th>
                                <th>Sign-ins</th>
                                <th>Impersonation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const row of _rows) { %>
                                <tr>
                                    <td>
                                        <a href="<%= Rsx.Route('_Sys_Portal_User_Session_View_Action', {id: this.args.portal_user_id, user_session_id: row.id}) %>" title="<%= row.user_agent || '' %>"><%= row.device_summary %></a>
                                        <% if (row.is_current) { %>
                                            <span class="_Sys_Portal_User_Sessions__note">this browser</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (row.is_signed_in) { %>
                                            <_Sys_Status_Badge $status="ok" $label="Signed in" />
                                        <% } else { %>
                                            <_Sys_Status_Badge $status="muted" $label=(row.sign_out_reason || 'Signed out') />
                                            <span class="_Sys_Portal_User_Sessions__dim"><%= Rsx_Time.relative(row.signed_out_at) %></span>
                                        <% } %>
                                    </td>
                                    <td class="_Sys_Portal_User_Sessions__mono"><%= row.ip_address %></td>
                                    <td><%= row.signed_in_at ? Rsx_Time.format_datetime(row.signed_in_at) : '' %></td>
                                    <td><%= row.last_active ? Rsx_Time.relative(row.last_active) : '' %></td>
                                    <td><%= row.sign_in_count %></td>
                                    <td>
                                        <% if (row.is_impersonation) { %>
                                            <_Sys_Status_Badge $status="info" $label="View as Client" />
                                            <% if (row.impersonator_login_user_id) { %>
                                                by <a href="<%= Rsx.Route('_Sys_User_View_Action', row.impersonator_login_user_id) %>"><%= row.impersonator_email || ('#' + row.impersonator_login_user_id) %></a>
                                            <% } %>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </Slot:body>
    </_Sys_Section>
<% } %>
</Define:_Sys_Portal_User_Sessions>
