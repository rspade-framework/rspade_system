<%--
_Sys_Portal_User_View_Action - one client-portal user (portal_users.id): its facts, where it
is signed in, its portal sign-in history and its second factors and connected sign-in
providers. READ-ONLY - the panel changes nothing about a portal account.

Three states: loading, a load failure (_Sys_Not_Found for a missing or soft-deleted portal
user; _Sys_Error for anything else), and the record - a header over four tabs (hash key
"tab"):

    overview - the portal user's facts
    sessions - _Sys_Portal_User_Sessions (self-loading)
    signins  - _Sys_Portal_User_Signins_DataGrid (grid key "signins", every row, paged)
    security - _Sys_Portal_User_Security (self-loading)
--%>
<Define:_Sys_Portal_User_View_Action>
<_Sys_Page_Scaffold>
    <Slot:main>
    <% if (this.data.loading) { %>
        <Spinner class="_Sys_Portal_User_View_Action__loading" />
    <% } else if (this.data.load_error && this.data.load_error.code === Ajax.ERROR_NOT_FOUND) { %>
        <_Sys_Not_Found $record_type="Portal user" $back_label="Back to portal users" $back_url=(Rsx.Route('_Sys_Portal_Users_Action')) />
    <% } else if (this.data.load_error) { %>
        <_Sys_Error $error_data=this.data.load_error.message />
    <% } else { %>
        <%
            const _u = this.data.user;
            const _site = '#' + _u.site_id + ' ' + (_u.site_name || '(deleted site)');
        %>
        <_Sys_Page_Header $title=_u.email $icon="bi-person-vcard" $subtitle=('Portal user #' + _u.id + ' - site ' + _site)>
            <Slot:meta>
                <_Sys_Status_Badge $status=_u.status $label=_u.status_label />
                <% if (!_u.is_verified) { %>
                    <_Sys_Status_Badge $status="muted" $label="Unverified" />
                <% } %>
                <% if (_u.password_reset_required) { %>
                    <_Sys_Status_Badge $status="warn" $label="Reset required" />
                <% } %>
            </Slot:meta>
            <Slot:actions>
                <a class="btn btn-sm btn-secondary" href="<%= Rsx.Route('_Sys_Portal_Users_Action') %>">All portal users</a>
            </Slot:actions>
        </_Sys_Page_Header>

        <_Sys_Tabs $sid="tabs" $hash="tab" $tabs=([
            {key: 'overview', label: 'Overview', icon: 'bi-info-circle'},
            {key: 'sessions', label: 'Sessions', icon: 'bi-laptop'},
            {key: 'signins', label: 'Sign-ins', icon: 'bi-box-arrow-in-right'},
            {key: 'security', label: 'Security', icon: 'bi-shield-lock'},
        ])>
            <Slot:overview>
                <_Sys_Section $title="Details" $icon="bi-info-circle">
                    <_Sys_Detail_List>
                        <_Sys_Detail_Item $label="ID" $value=_u.id $mono=true />
                        <_Sys_Detail_Item $label="Email" $value=_u.email />
                        <% if (_u.printed_name !== _u.email) { %>
                            <_Sys_Detail_Item $label="Name" $value=_u.printed_name />
                        <% } %>
                        <_Sys_Detail_Item $label="Site">
                            <% if (_u.has_site_screen) { %>
                                <a href="<%= Rsx.Route('_Sys_Site_View_Action', _u.site_id) %>"><%= _site %></a>
                            <% } else { %>
                                <%= _site %>
                            <% } %>
                        </_Sys_Detail_Item>
                        <_Sys_Detail_Item $label="Status">
                            <_Sys_Status_Badge $status=_u.status $label=_u.status_label />
                        </_Sys_Detail_Item>
                        <_Sys_Detail_Item $label="Verified" $value=(_u.is_verified ? 'Yes' : 'No') />
                        <_Sys_Detail_Item $label="Can sign in" $value=(_u.can_login ? 'Yes - active and verified' : 'No - a portal sign-in needs an active, verified account') />
                        <_Sys_Detail_Item $label="Password reset" $value=(_u.password_reset_required ? 'Required - the next password sign-in is refused until it is changed' : 'Not required') />
                        <_Sys_Detail_Item $label="Last sign-in" $value=(_u.last_login ? Rsx_Time.format_datetime(_u.last_login) : 'Never') />
                        <_Sys_Detail_Item $label="Last seen" $value=(_u.last_seen ? Rsx_Time.format_datetime(_u.last_seen) : 'Never') />
                        <_Sys_Detail_Item $label="Created" $value=(_u.created_at ? Rsx_Time.format_datetime(_u.created_at) : null) />
                        <_Sys_Detail_Item $label="Updated" $value=(_u.updated_at ? Rsx_Time.format_datetime(_u.updated_at) : null) />
                    </_Sys_Detail_List>
                </_Sys_Section>
            </Slot:overview>
            <Slot:sessions><_Sys_Portal_User_Sessions $sid="sessions" $portal_user_id=_u.id /></Slot:sessions>
            <Slot:signins><_Sys_Portal_User_Signins_DataGrid $sid="signins" $base_params=({portal_user_id: _u.id}) /></Slot:signins>
            <Slot:security><_Sys_Portal_User_Security $sid="security" $portal_user_id=_u.id /></Slot:security>
        </_Sys_Tabs>
    <% } %>
    </Slot:main>
</_Sys_Page_Scaffold>
</Define:_Sys_Portal_User_View_Action>
