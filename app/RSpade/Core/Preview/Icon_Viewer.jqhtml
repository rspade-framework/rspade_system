<%--
Icon_Viewer

Terminal viewer for file types with no in-browser preview: a centered extension icon plus the
file name. Emits 'preview_loaded' {pages:1, state:'loaded', attachment_id} as soon as it is on the
page - the icon and the name ARE its content. set_page is a no-op.

Args: $url (extension icon), $extension, $file_name, $attachment_id (optional; echoed in the event).
--%>
<Define:Icon_Viewer tag="div">
    <img $sid="icon" class="Icon_Viewer__icon" src="<%= this.args.url %>" alt="">
    <% if (this.args.extension) { %>
        <div class="Icon_Viewer__ext"><%= String(this.args.extension).toUpperCase() %></div>
    <% } %>
    <% if (this.args.file_name) { %>
        <div class="Icon_Viewer__name"><%= this.args.file_name %></div>
    <% } %>
</Define:Icon_Viewer>
