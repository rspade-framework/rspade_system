<Define:Api_Code_Samples tag="div">
<% const samples = this.state.samples; %>
<div class="Api_Code_Samples__tabs" $sid="tabs">
    <% for (let i = 0; i < samples.length; i++) { %>
        <% const active = (i === this.state.active) ? ' Api_Code_Samples__tab--active' : ''; %>
        <button type="button" class="Api_Code_Samples__tab<%= active %>" data-idx="<%= i %>"><%= samples[i].lang %></button>
    <% } %>

    <%-- Off by default: the documentation sample is what most readers want, and it is the one
         that is safe to copy anywhere. Switching it on turns the sample into the exact request
         the tester below would send, real key included. --%>
    <label class="Api_Code_Samples__fill">
        <input type="checkbox" $sid="fill" <% if (this.state.fill) { %>checked<% } %>>
        <span>Fill in values</span>
    </label>
</div>
<div class="Api_Code_Samples__panes" $sid="panes">
    <% for (let i = 0; i < samples.length; i++) { %>
        <% const hidden = (i === this.state.active) ? '' : ' Api_Code_Samples__pane--hidden'; %>
        <div class="Api_Code_Samples__pane<%= hidden %>" data-idx="<%= i %>">
            <button type="button" class="Api_Code_Samples__copy" data-idx="<%= i %>"><%!= api_icon('copy') %><span>Copy</span></button>
            <pre class="Api_Code_Samples__pre" data-idx="<%= i %>" data-hl="<%= samples[i].hl %>"></pre>
        </div>
    <% } %>
</div>
</Define:Api_Code_Samples>
